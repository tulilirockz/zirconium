#!/usr/bin/env bash

set -euo pipefail

TARGET_DISK_DATA="$(gum choose --limit=1 --ordered --header="Select the installation media to install Zirconium to:" --select-if-one $(lsblk -J | jq -rc '.blockdevices[] | select(.type == "disk") | .name' | grep -v 'zram'))"
gum confirm "The disk ${TARGET_DISK}"
EXIT_CODE="$?"
case "${EXIT_CODE}" in
  0)
    ;;
  *)
    echo "Installation canceled"
    exit 0
esac


pkexec bootc install to-disk --wipe --target-imageref ghcr.io/zirconium-dev/zirconium:latest --enforce-container-sigpolicy --skip-fetch-check --source-imgref oci:/usr/lib/zirconium/install/zirconium-oci "${TARGET_DISK}"

